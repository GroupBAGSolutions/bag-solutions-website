# URL pública del sitio (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://groupbagsolutions.com

# Formulario de contacto (Resend). Solo falta pegar la API key y verificar el dominio en Resend.
RESEND_API_KEY=
RESEND_FROM="BAG Solutions <no-reply@groupbagsolutions.com>"
CONTACT_TO=info@groupbagsolutions.com

# Cloudflare Turnstile (opcional: si se dejan vacías, el formulario funciona sin captcha)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analítica (opcional: sin IDs no se muestra el banner ni se carga nada)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console: verificación por meta tag (opcional si ya se verificó por DNS)
NEXT_PUBLIC_GSC_VERIFICATION=
